/* ==========================================================================
   GLOBAL CRITICAL UPGRADES: TYPOGRAPHY, IMAGES & MOBILE MENU
   ========================================================================== */
.aspect-video {
  aspect-ratio: 16 / 9 !important;
  width: 100% !important;
  overflow: hidden !important;
  background-color: var(--bg-surface, #1e293b) !important;
}
.aspect-video > img, img.aspect-video {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  object-position: center !important;
}

/* Mobile Drawer Smooth Transitions */
#mobile-menu-drawer, #mobile-drawer {
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease !important;
}
#mobile-menu-drawer.drawer-closed, #mobile-drawer.drawer-closed {
  transform: translateX(100%) !important;
  opacity: 0 !important;
  pointer-events: none !important;
}
#mobile-menu-drawer.drawer-open, #mobile-drawer.drawer-open {
  transform: translateX(0) !important;
  opacity: 1 !important;
  pointer-events: auto !important;
}

/* Global Typography & Readability Harmonization */
html.dark h1, html.dark h2, html.dark h3, html.dark h4,
html.dark .prose h1, html.dark .prose h2, html.dark .prose h3, html.dark .prose h4,
html.dark .article-content h1, html.dark .article-content h2, html.dark .article-content h3, html.dark .article-content h4 {
  color: #F8FAFC !important;
  font-weight: 700 !important;
}

html.dark .article-content p,
html.dark .article-content li,
html.dark .prose p,
html.dark .prose li {
  color: #CBD5E1 !important;
  font-size: 1.05rem !important;
  line-height: 1.8 !important;
}

html.dark .card-meta-footer,
html.dark .article-meta,
html.dark .text-slate-400,
html.dark .text-slate-500,
html.dark time {
  color: #94A3B8 !important;
}

